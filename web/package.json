{
  "name": "ephemeris-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EPHEMERIS web shell: the Rust engine in WASM, drawn with React (docs/phase2-design.md)",
  "scripts": {
    "wasm": "wasm-pack build ../crates/ephemeris-wasm --target web --release --out-dir ../../web/src/wasm/pkg",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run wasm && vitest run",
    "dev:desktop": "vite --mode desktop",
    "build:desktop": "npm run wasm && tsc --noEmit -p . && vite build --mode desktop",
    "tauri": "cd ../crates/ephemeris-desktop && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
