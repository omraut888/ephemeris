{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPHEMERIS",
  "version": "0.1.0",
  "identifier": "dev.ephemeris.desktop",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../web/dist-desktop",
    "beforeDevCommand": { "script": "npm run dev:desktop", "cwd": "../../web" },
    "beforeBuildCommand": { "script": "npm run build:desktop", "cwd": "../../web" }
  },
  "app": {
    "windows": [
      {
        "title": "EPHEMERIS",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Finance",
    "shortDescription": "Where your money is headed, with honest odds",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
